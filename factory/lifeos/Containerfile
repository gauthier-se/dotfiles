# LifeOS on the agent factory (ADR-0019 in the private docs): one long-lived
# container for the `lifeos` user, apart from the coding agents. Its home is a
# named volume, so LifeOS, its memory and its TELOS survive a rebuild of this
# image; the image only brings the tools.
#
# Built by `lifeos` from the copy NixOS puts in /etc/factory/lifeos; the user
# service builds it on first start if it is missing.
FROM mcr.microsoft.com/devcontainers/base:ubuntu-24.04

COPY lifeos-claude lifeos-launch lifeos-pulse /usr/local/bin/
RUN chmod 0755 /usr/local/bin/lifeos-claude /usr/local/bin/lifeos-launch /usr/local/bin/lifeos-pulse

# gh is the system of record of LifeOS's Work System, with no fallback; rg is
# what its tools spawn; python3 is what node-gyp needs to build node-pty during
# installs and updates (make and g++ come with the base image).
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh ripgrep python3 \
 && rm -rf /var/lib/apt/lists/*

USER vscode
WORKDIR /home/vscode
ENV PATH=/home/vscode/.bun/bin:/home/vscode/.local/bin:$PATH

# LifeOS needs bun 1.2 or newer. Pinned like Claude Code: an upgrade is a
# rebuild, decided, not a surprise.
ARG BUN_VERSION=bun-v1.4.4
RUN curl -fsSL https://bun.sh/install | bash -s "$BUN_VERSION" && bun --version

ARG CLAUDE_CODE_VERSION=2.1.327
ENV DISABLE_AUTOUPDATER=1
RUN curl -fsSL https://claude.ai/install.sh | bash -s "$CLAUDE_CODE_VERSION" \
 && claude --version

# Global rules, the same as everywhere else.
# Writable: LifeOS appends its identity imports below these rules. The Nix
# store copy is 0444, which COPY would otherwise keep.
COPY --chown=vscode:vscode --chmod=0644 CLAUDE.md /home/vscode/.claude/CLAUDE.md
RUN printf '%s\n' '{"hasCompletedOnboarding": true}' > /home/vscode/.claude.json

CMD ["lifeos-pulse"]
