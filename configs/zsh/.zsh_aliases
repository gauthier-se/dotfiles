# Navigation
alias ll="ls -lshA"
alias la="ls -A"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Editors & Tools
alias mux="tmuxinator"
alias cat="bat -p"
alias lg="lazygit"
alias ld="lazydocker"

# glow's "auto" style cannot detect the background inside tmux: follow the
# `theme` script instead (its modes are glow's dark/light style names).
# A -s passed on the command line still wins, the last flag is kept.
glow() {
  command glow -s "$(<~/.local/state/theme/mode 2>/dev/null || echo dark)" "$@"
}

# Dotfiles
alias openzs="vim ~/dotfiles/configs/zsh/.zshrc"
alias sourcezs="source ~/.zshrc"

# System — this file is shared between the Mac and every NixOS machine.
# On NixOS the flake attribute is the hostname (laptop, devbox…), so $HOST picks
# the right one instead of hardcoding a machine that is not the one being typed on.
if [[ "$OSTYPE" == darwin* ]]; then
  alias update="sudo darwin-rebuild switch --flake ~/dotfiles/nix"
  alias upgrade="nix flake update --flake ~/dotfiles/nix \
    && sudo darwin-rebuild switch --flake ~/dotfiles/nix \
    && brew update && brew upgrade --cask && mas upgrade"
else
  alias update="sudo nixos-rebuild switch --flake ~/dotfiles/nix#$HOST"
  alias upgrade="nix flake update --flake ~/dotfiles/nix \
    && sudo nixos-rebuild switch --flake ~/dotfiles/nix#$HOST"
fi
