[global]
    monitor = 0
    follow = mouse

    # Geometry
    width = 340
    height = 120
    origin = top-right
    offset = 12x52
    scale = 0
    notification_limit = 5

    # Appearance
    frame_width = 1
    frame_color = "#313244"
    gap_size = 6
    corner_radius = 10
    transparency = 8

    font = JetBrainsMono Nerd Font Mono 12
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_theme = Papirus-Dark, hicolor
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    # Padding
    padding = 10
    horizontal_padding = 14
    text_icon_padding = 10

    # Behaviour
    timeout = 5
    sticky_history = yes
    history_length = 20

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    dmenu = wofi --dmenu -p dunst
    browser = xdg-open

    sort = yes
    idle_threshold = 120

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#313244"
    timeout = 4
    icon = dialog-information

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
    icon = dialog-error
