[user]
# The GitHub account's own identity, so a commit made here and a commit made by
# GitHub (a squash merge, a web edit) are the same author. The noreply alias is
# what the account publishes while "keep my email addresses private" is on, and
# it is what links a commit to the profile: a personal address that is not among
# the account's verified emails is attributed to nobody at all.
name = gauthier-se
email = 139963620+gauthier-se@users.noreply.github.com

[core]
editor = nvim
autocrlf = input
excludesfile = ~/.gitignore_global
pager = delta

[init]
defaultBranch = main

[pull]
	rebase = true

[push]
autoSetupRemote = true

[color]
ui = auto

[interactive]
diffFilter = delta --color-only

[delta]
features = moonfly
navigate = true
line-numbers = true
side-by-side = false

[merge]
conflictstyle = zdiff3

[diff]
colorMoved = zebra

[include]
path = ~/moonfly.gitconfig
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
