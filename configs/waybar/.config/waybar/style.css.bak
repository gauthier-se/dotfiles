/* Catppuccin Mocha */
@define-color base     #1e1e2e;
@define-color mantle   #181825;
@define-color surface0 #313244;
@define-color surface1 #45475a;
@define-color overlay0 #6c7086;
@define-color text     #cdd6f4;
@define-color subtext0 #a6adc8;
@define-color blue     #89b4fa;
@define-color lavender #b4befe;
@define-color sapphire #74c7ec;
@define-color sky      #89dceb;
@define-color teal     #94e2d5;
@define-color green    #a6e3a1;
@define-color yellow   #f9e2af;
@define-color peach    #fab387;
@define-color red      #f38ba8;
@define-color mauve    #cba6f7;

* {
    font-family: "JetBrainsMono Nerd Font Mono", monospace;
    font-size: 13px;
    border: none;
    border-radius: 0;
    min-height: 0;
}

window#waybar {
    background-color: alpha(@base, 0.92);
    color: @text;
    border-radius: 12px;
    border: 1px solid @surface0;
}

/* ── Sections ─────────────────────────────────────── */

.modules-left,
.modules-right {
    padding: 0 6px;
}

.modules-center {
    padding: 0 4px;
}

/* ── Workspaces ──────────────────────────────────── */

#workspaces {
    margin: 0 6px;
    padding: 0 4px;
}

#workspaces button {
    padding: 0 6px;
    font-size: 11px;
    color: @surface1;
    background: transparent;
    border: none;
    border-radius: 0;
    margin: 0;
    transition: color 0.2s ease, transform 0.2s ease;
}

#workspaces button:hover {
    color: @overlay0;
    background: transparent;
    box-shadow: none;
    text-shadow: none;
}

#workspaces button.active {
    color: @blue;
    font-size: 13px;
}

#workspaces button.urgent {
    color: @red;
}

/* ── Window title ────────────────────────────────── */

#window {
    color: @subtext0;
    padding: 0 8px;
    font-style: italic;
}

/* ── Clock ───────────────────────────────────────── */

#clock {
    color: @lavender;
    font-weight: bold;
    padding: 0 14px;
}

/* ── Right modules shared ────────────────────────── */

/* Stats group: single unified pill containing cpu/mem/backlight/wireplumber/network/battery */
#stats {
    background: @surface0;
    border-radius: 10px;
    margin: 4px 0;
    padding: 0 4px;
}

#cpu,
#memory,
#backlight,
#wireplumber,
#network,
#battery {
    padding: 2px 10px;
    margin: 0;
    background: transparent;
    border-radius: 0;
}

/* Subtle separators between logical groups: system | hardware | connectivity */
#backlight,
#network {
    border-left: 1px solid alpha(@overlay0, 0.35);
    margin-left: 2px;
    padding-left: 12px;
}

/* ── Per-module colors ───────────────────────────── */

#cpu {
    color: @green;
}

#cpu.high {
    color: @red;
}

#memory {
    color: @sapphire;
}

#backlight {
    color: @yellow;
}

#wireplumber {
    color: @mauve;
}

#wireplumber.muted {
    color: @overlay0;
}

#network {
    color: @blue;
}

#network.disconnected {
    color: @red;
}

#battery {
    color: @green;
}

#battery.charging {
    color: @teal;
}

#battery.warning:not(.charging) {
    color: @yellow;
}

#battery.critical:not(.charging) {
    color: @red;
    animation: blink 1s linear infinite alternate;
}

@keyframes blink {
    to { opacity: 0.4; }
}

#tray {
    background: transparent;
    padding: 2px 6px;
    margin-left: 8px;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    background: alpha(@red, 0.2);
    border-radius: 6px;
}
